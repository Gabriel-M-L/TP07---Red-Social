@{
    ViewData["Title"] = "Registro";
}

<div class="register-card card shadow-sm">
    <div class="card-body">
        <h1 class="h3 text-center text-gradient mb-4">Crear cuenta</h1>
        <div class="alert alert-warning">@ViewBag.MensajeError</div>
        <form action="@Url.Action("RegistroUsuario", "Home")" method="post" onsubmit="return VerificarRegistro()">
            <div class="mb-3">
                <p class="form-label">Nombre de usuario</p>
                <input type="text" class="form-control" name="nombreUsuario" id="nombreUsuario" placeholder="Ingresa tu usuario">
            </div>
            <div class="mb-3">
                <p class="form-label">Contraseña</p>
                <input type="password" class="form-control" name="password" id="password" placeholder="Ingresa tu contraseña">
            </div>
            <div class="mb-3">
                <p class="form-label">Nombre</p>
                <input type="text" class="form-control" name="nombre" id="nombre" placeholder="Ingresa tu nombre">
            </div>
            <div class="mb-3">
                <p class="form-label">Apellido</p>
                <input type="text" class="form-control" name="apellido" id="apellido" placeholder="Ingresa tu apellido">
            </div>
            <button type="submit" class="btn btn-primary w-100">Crear cuenta</button>
            <p id="error"></p>
        </form>
        <p class="text-center mt-3 mb-0">¿Ya tenes una cuenta? <a href="@Url.Action("Login", "Home")">Iniciar sesión</a></p>
    </div>
</div>